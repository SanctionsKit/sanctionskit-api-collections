meta {
  name: 06 Screen a vessel
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/screenings
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
  Idempotency-Key: {{vesselKey}}
}

body:json {
  {
    "subject": {
      "name": "Example Horizon",
      "entityType": "vessel",
      "identifiers": [
        {
          "type": "imo",
          "value": "0000001"
        }
      ]
    },
    "package": "sandbox@1",
    "retention": "standard"
  }
}

script:pre-request {
  let key = bru.getEnvVar("vesselKey");
  if (!key) {
    key = bru.interpolate("{{$randomUUID}}");
    bru.setEnvVar("vesselKey", key);
  }
  if (!/^[\w:.-]{8,128}$/.test(key)) {
    throw new Error("Set vesselKey to an 8-128 character operation key.");
  }
  req.setHeader("Idempotency-Key", key);
}

tests {
  test("HTTP 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  if (res.getStatus() === 201) {
    const body = res.getBody();
    const result = body.data;
    test("Synthetic screening result", function () {
      expect(result.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);
      expect(result.environment).to.equal("sandbox");
      expect(result.matches).to.be.an("array");
      expect(result.coverage).to.be.an("array").that.is.not.empty;
      expect(result.versions.package).to.equal("sandbox@1");
      expect(result.status).to.equal("potential_match");
      expect(result.matches).to.not.be.empty;
    });
  }
}

docs {
  Example Horizon and IMO 0000001 are invented sandbox fixtures. Expect potential_match. This request leaves resultId unchanged. Scope: screenings:write.

  [Documentation](https://www.sanctionskit.com/docs/screenings)
}
